# ==============================================================================
# Internal Developer Platform (IDP) - Production Environment Configuration
# ==============================================================================
# Copy this file to .env on your VPS and update the placeholder values.

# ------------------------------------------------------------------------------
# 1. Domains & Hostnames (Match your DNS A-records)
# ------------------------------------------------------------------------------
APP_DOMAIN=idp.yourdomain.com
AUTH_DOMAIN=auth.yourdomain.com

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_DB=idpdb
POSTGRES_USER=idpuser
POSTGRES_PASSWORD=replace_with_strong_postgres_password_here

# ------------------------------------------------------------------------------
# 3. Redis High-Performance Distributed Cache
# ------------------------------------------------------------------------------
REDIS_PASSWORD=replace_with_strong_redis_password_here

# ------------------------------------------------------------------------------
# 4. RabbitMQ Message Broker
# ------------------------------------------------------------------------------
RABBITMQ_USER=idp_mq_admin
RABBITMQ_PASSWORD=replace_with_strong_rabbitmq_password_here

# ------------------------------------------------------------------------------
# 5. Keycloak IAM (OAuth2 / OIDC SSO Server)
# ------------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace_with_strong_keycloak_admin_password_here

# ------------------------------------------------------------------------------
# 6. Spring Boot Core API Security
# ------------------------------------------------------------------------------
# In production, tokens are signed by your Keycloak domain
IDP_SECURITY_ISSUER_URI=https://auth.yourdomain.com/realms/idp-realm
IDP_SECURITY_JWK_SET_URI=http://keycloak:8180/realms/idp-realm/protocol/openid-connect/certs
IDP_SECURITY_CORS_ORIGINS=https://idp.yourdomain.com
IDP_SECURITY_AUTO_PROVISION=false
